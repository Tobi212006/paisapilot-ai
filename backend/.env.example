CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DATABASE_PATH=./paisa_pilot.db
APP_ENV=development
DEMO_MODE=true
# Production must use APP_ENV=production, DEMO_MODE=false, explicit HTTPS CORS,
# durable DATABASE_PATH, and configured Supabase authentication.
# Both Supabase values are required to enable private sign-in. No service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional provider secrets. Never prefix these with VITE_ or commit actual keys.
UPSTOX_ANALYTICS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional alternative for monthly aggregate explanations (server only).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
